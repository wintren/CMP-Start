.gradle/
build/
.kotlin/
local.properties
*.iml
.DS_Store
xcuserdata/
*.hprof

# IDE: the shared code style is checked in, the rest is per-machine. Run configurations live in
# .run/, which is the location IntelliJ shares between everyone on a project.
.idea/*
!.idea/codeStyles/

# Generated by Gradle's `updateDaemonJvm`; pins the daemon JVM to whatever JDK the machine that ran
# it had, with per-platform foojay download ids. The wrapper plus `jvmToolchain` is enough — and
# build-logic compiles at 17 so the daemon's own JDK no longer matters.
gradle/gradle-daemon-jvm.properties

# kotlin-js-store/wasm/yarn.lock IS tracked, on purpose: it is what makes a web build reproducible,
# and `kotlinWasmStoreYarnLock` fails the build when it drifts. Run `kotlinWasmUpgradeYarnLock`
# after changing a dependency that pulls npm packages, and commit the result.
