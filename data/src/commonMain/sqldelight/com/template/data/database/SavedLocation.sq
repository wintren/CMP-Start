-- The current schema. `Schema.create` runs this on a fresh install; an install still on an older
-- version is brought here by the files in `migrations/`, so this file and the migrations together
-- must describe the same table.
CREATE TABLE savedLocation (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    country TEXT,
    region TEXT,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    time_zone TEXT NOT NULL
);

selectAll:
SELECT * FROM savedLocation ORDER BY name ASC;

upsert:
INSERT OR REPLACE INTO savedLocation(id, name, country, region, latitude, longitude, time_zone)
VALUES (?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM savedLocation WHERE id = ?;
